{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asta-chemma-server",
  "main": "src/worker.ts",
  // On or after 2026-08-04: nodejs_compat is on by default and closes are auto-replied.
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      // Quick match: the waiting line(s).
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" },
    "Matchmaker": { "type": "durable-object", "storage": "sqlite" }
  },
  // Postgres (Neon) through Hyperdrive. Locally and in tests the connection
  // string comes from CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // (a PGlite server started by scripts/dev.mjs or the test setup).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "6d21846b049a4e59a1022547c40c4fd8" }],
  // At most 10 new guest accounts per minute from one address.
  "ratelimits": [{ "name": "GUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    // Google sign-in: ID tokens must be issued for our Web client (not secret).
    "GOOGLE_CLIENT_IDS": "743187252908-gfthj90i9kealbdok71ub1bluqruiohe.apps.googleusercontent.com",
    // Public contact address on /privacy and /delete-account (also the Play Store contact email).
    "SUPPORT_EMAIL": "mail.businessworks@gmail.com",
    // Server error reports (Sentry project astachemma-server). Not secret: it only lets
    // the server send reports. Tests and local dev switch it off.
    "SENTRY_DSN": "https://dcba6cb32d7b3dee4703ada3b18b8186@o4512481138704384.ingest.us.sentry.io/4512486455443456"
  },
  "observability": { "enabled": true }
}
