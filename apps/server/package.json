{
  "name": "@asta/server",
  "version": "3.0.0",
  "private": true,
  "description": "Online game server for Asta Chemma on Cloudflare Workers + Durable Objects: rooms with a code, server-side shell throws and computer players.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "vitest run && wrangler deploy",
    "logs": "wrangler tail --format pretty",
    "types": "wrangler types src/worker-configuration.d.ts",
    "test": "vitest run",
    "typecheck": "wrangler types src/worker-configuration.d.ts && tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@asta/engine": "*",
    "@asta/protocol": "*",
    "@sentry/cloudflare": "^11.17.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.166.0",
    "ws": "^8.23.0"
  }
}
